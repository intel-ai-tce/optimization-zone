# Dockerfile
# Build intel-speed-select from Linux kernel v6.8 tools tree on Ubuntu.
#
# This image produces /usr/bin/intel-speed-select inside the container.
# To *use* it against host hardware, you will typically need --privileged and
# access to /dev/cpu/*/msr (plus relevant /sys entries) on the host.

FROM ubuntu:24.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG KERNEL_TAG=v6.8

# Build dependencies stay in this disposable stage.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    make \
    gcc \
    libc6-dev \
    libnl-3-dev \
    libnl-genl-3-dev \
    && rm -rf /var/lib/apt/lists/*

# Fetch Linux kernel source (tools tree includes intel-speed-select)
WORKDIR /opt
RUN git clone --depth 1 --branch "${KERNEL_TAG}" \
        https://github.com/torvalds/linux.git /opt/linux \
    && make -C /opt/linux/tools/power/x86/intel-speed-select \
        -j"$(nproc)" \
    && make -C /opt/linux/tools/power/x86/intel-speed-select install

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# Runtime libraries for intel-speed-select and tools required by the PCT scripts.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnl-3-200 \
    libnl-genl-3-200 \
    python3 \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/bin/intel-speed-select /usr/bin/intel-speed-select

WORKDIR /workspace

# No ENTRYPOINT so docker compose can run arbitrary commands (bash, etc.)
CMD ["intel-speed-select", "--help"]
